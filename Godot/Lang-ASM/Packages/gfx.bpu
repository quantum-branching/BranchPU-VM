JMP 0 .gfx_main;

#define xpix $254
#define ypix $255

#implies #define xmin #64
#implies #define ymin #128
#implies #define xmax #96
#implies #define ymax #160

#define PORT_GPU 1

#define GT 1
#define EQ 2
#define GTE 3
#define LTE 5
#define NE 6
#define LT 7

.gfx_fill
	LDA xmin;
	STA xpix;
	LDA ymin;
	STA ypix;
	.gfxfill_loop
		WPR 1 ypix;
		WPR 1 xpix;
		LDA xpix;
		ADD #01;
		STA xpix;
		CMP GT xmax;
		CND 0 .gfxfill_loop;
			LDA xmin;
			STA xpix;
			LDA ypix;
			ADD #01;
			STA ypix;
			CMP GT ymax;
			CND 0 .gfxfill_loop;
	POP;

.gfx_main
