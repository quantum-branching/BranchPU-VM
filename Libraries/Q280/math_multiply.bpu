#removeBlank
#define EQ 2

JMP 0 .math_mult_main

;def multiply(x, y):
.math_multiply

	;z = 0
	LDI #0;
	STA $3;

	.math_mult_loop;
	
	;while y:
	LDA $2;		
	ICP EQ #0;
	CND .math_mult_return;

		;if y & 1 != 0:
		AND #1;
		ICP EQ #0;
		CND  .math_mult_skip_add;

			;z += x
			LDA $3;
			ADD $1;
			STA $3;

		.math_mult_skip_add;

		;x <<= 1
		LDA $1;
		LSH #1;
		STA $1;

		;y >>= 1
		LDA $2;
		RSH #1;
		STA $2;

	JMP  .math_mult_loop;
	.math_mult_return;

	;return z
	LDA 3;
	POP;

.math_mult_main